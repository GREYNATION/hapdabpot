{
  "name": "hapdabot",
  "version": "1.0.0",
  "description": "Gravity Claw Telegram Bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation tsx src/index.ts",
    "build": "tsc && node scripts/sync-assets.js",
    "start": "cross-env NODE_OPTIONS=--no-deprecation node dist/index.js",
    "deploy": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "bot": "cross-env NODE_OPTIONS=--no-deprecation tsx src/bot.ts",
    "scan": "cross-env NODE_OPTIONS=--no-deprecation tsx src/index.ts --scan-now"
  },
